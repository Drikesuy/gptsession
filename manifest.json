{
  "manifest_version": 3,
  "name": "gptsession",
  "short_name": "gptsession",
  "version": "1.1.0",
  "version_name": "1.1.0",
  "description": "One-click silent injection of ChatGPT Session Token for passwordless login",
  "minimum_chrome_version": "110",
  "author": "Drikesuy",
  "homepage_url": "https://github.com/Drikesuy/gptsession",
  "permissions": ["cookies", "tabs", "storage", "clipboardRead"],
  "host_permissions": ["https://chatgpt.com/*", "https://*.chatgpt.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "gptsession",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  }
}
